# ============================================================
# V-POKER 生产环境变量配置模板
#
# 使用方法：
#   sudo cp deploy/.env.prod.example /opt/vpoker/.env.prod
#   sudo chmod 600 /opt/vpoker/.env.prod
#   sudo chown root:root /opt/vpoker/.env.prod
# ============================================================

# Spring Boot 运行 Profile
SPRING_PROFILES_ACTIVE=prod

# MySQL 生产数据库连接配置
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/poker_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&zeroDateTimeBehavior=convertToNull
SPRING_DATASOURCE_USERNAME=poker
# 【必须修改】生产数据库密码（请使用强密码）
SPRING_DATASOURCE_PASSWORD=YourStrongDatabasePasswordHere!

# JWT 鉴权密钥（生产环境【必须修改】为随机长串，≥32 字符，防止客户端伪造 Token）
JWT_SECRET=vpoker-super-secret-key-prod-2026-replace-with-random-32char-string

# 是否开启 H2 控制台（生产环境必须为 false）
SPRING_H2_CONSOLE_ENABLED=false

# 数据库初始化模式（首次上线填 always，稳定后建议改为 never 并由备份维护）
SPRING_SQL_INIT_MODE=never

# JVM 内存与垃圾回收器配置
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC -Dfile.encoding=UTF-8
